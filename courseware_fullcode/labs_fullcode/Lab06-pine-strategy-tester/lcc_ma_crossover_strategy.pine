//@version=6
// Lab 06 - Lion City Capital (fictitious, for training)
// Long-only moving-average crossover strategy for the TradingView Strategy Tester.
// Orders are filled on the NEXT bar's open (process_orders_on_close = false),
// with a commission per order and slippage, so results are net of trading costs.
// Educational use only - not investment advice.
strategy("LCC MA Crossover Strategy", shorttitle = "LCC MA-X", overlay = true,
     initial_capital = 100000, currency = currency.USD,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.cash_per_order, commission_value = 1.0,
     slippage = 2, pyramiding = 0, process_orders_on_close = false,
     margin_long = 100, margin_short = 100)

// ---- Inputs
fastLen   = input.int(50, "Fast SMA length", minval = 1)
slowLen   = input.int(200, "Slow SMA length", minval = 2)
startTime = input.time(timestamp("2018-01-01T00:00:00"), "Backtest start date")
endTime   = input.time(timestamp("2025-12-31T23:59:59"), "Backtest end date")

// ---- Indicators
fastMA = ta.sma(close, fastLen)
slowMA = ta.sma(close, slowLen)
inWindow = time >= startTime and time <= endTime

// ---- Rules: buy on a golden cross, exit on a death cross
goLong  = ta.crossover(fastMA, slowMA) and inWindow
goFlat  = ta.crossunder(fastMA, slowMA)

if goLong
    strategy.entry("Long", strategy.long, comment = "Golden cross")
if goFlat
    strategy.close("Long", comment = "Death cross")
if time > endTime
    strategy.close_all(comment = "End of test window")

// ---- Visuals
plot(fastMA, "Fast SMA", color = color.blue, linewidth = 2)
plot(slowMA, "Slow SMA", color = color.orange, linewidth = 2)
bgcolor(strategy.position_size > 0 ? color.new(color.green, 92) : na, title = "In position")
