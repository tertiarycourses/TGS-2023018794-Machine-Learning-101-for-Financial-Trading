# Copy this file to .env (same folder) and fill in your Alpaca PAPER keys.
# Never commit .env to git or share it. Leave blank to run every lab in OFFLINE mode.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Lab 17 - shared secret that TradingView alerts must include
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Lab 20 - optional, enables Claude-powered news / debate agents
ANTHROPIC_API_KEY=

# Set to 1 to force offline mode even when keys are present
LAB_OFFLINE=
